# Keep testing and live deployments in separate Supabase projects.
COMPETITION_MODE=test
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STATUS_TOKEN_SECRET=
# The canonical URL for this deployment (no trailing slash).
SITE_URL=http://localhost:3000
# Use valid account details only when testing an actual transfer.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
ORGANIZER_WHATSAPP=
CONTACT_EMAIL=
# Optional factual details, leave blank until decided.
COMPETITION_VENUE=
COMPETITION_DATES=
SCREENING_VENUE=
SCREENING_DATE=
# Set to true ONLY on Vercel, whose trusted ingress supplies x-vercel-forwarded-for.
TRUST_VERCEL_IP=false
